{
  "name": "service-mensagens",
  "version": "1.3.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node ./src/utils/copy-prisma-generated.mjs",
    "dev": "cross-env NODE_ENV=development tsx server.ts",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "whatsapp:connect": "npm run build && node dist/src/scripts/connect-whatsapp.js",
    "whatsapp:delete-session": "npm run build && node dist/src/scripts/delete-whatsapp-session.js",
    "clear-messages": "npm run build && node dist/src/scripts/clear-messages.js",
    "alter-whatsapp-status": "node dist/src/scripts/config-start-whatsapp.js"
  },
  "author": "",
  "type": "module",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.2.0",
    "@prisma/client": "^6.19.3",
    "@react-email/components": "^1.0.11",
    "openai": "^6.16.0",
    "@react-email/render": "^2.0.5",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "inquirer": "^13.4.0",
    "nodemailer": "^9.0.1",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  }
