{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["server.ts", "prisma/**/*.ts", "src/**/*.ts"]
}